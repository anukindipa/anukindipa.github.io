---
import Base from "../layouts/Base.astro";

import LinkedInIcon from "../assets/icons/linkedin.svg";
import GithubIcon from "../assets/icons/github.svg";
---

<Base title="About | Anuks Blog" description="Learn more about Anuks Blog.">
    <div>
        <h1>About</h1>
        <p>
            I am Anuk Indipa Kankanam Gamage, a second year university student
            studying mathematics and statistics at the University of Melbourne.
        </p>
        <p>
            I am interested in systems programming, artificial intelligence,
            quantitative finance, applied mathematics and data science.
        </p>
        <p>
            This blog is a platform where I share my thoughts, projects, and
            learnings in these fields. I hope to share my learning and journey
            navigating the tech industry as a student and aspiring software
            engineer.
        </p>
    </div>
    <!-- links to my social  -->
    <div>
        <h2>Connect with Me</h2>
        <ul>
            <li>
                <a
                    href="https://www.linkedin.com/in/anuk-indipa-gamage-28728a314/"
                    target="_blank"
                >
                    <div class="social-text">> LinkedIn [</div>
                    <LinkedInIcon class="social-icon" />
                    <div class="social-text">]</div>
                </a>
            </li>
            <li>
                <a href="https://github.com/anukindipa" target="_blank">
                    <div class="social-text">> GitHub [</div>
                    <GithubIcon class="social-icon" />
                    <div class="social-text">]</div>
                </a>
            </li>
        </ul>
    </div>
</Base>

<style>
    .social-icon {
        width: 1.2rem;
        height: 1.2rem;
        vertical-align: middle;
        margin-right: 0.2rem;
        margin-left: 0.2rem;
    }
    ul {
        list-style-type: none;
        padding: 0;
    }
    a {
        text-decoration: none;
        color: var(--colors-link);
        font-size: 1.1rem;
        display: flex;
        margin-bottom: 0.8rem;
    }
</style>
